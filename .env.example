# Site
PUBLIC_SITE_URL=http://localhost:4321

# Atlas / AI runtime
OPENAI_API_KEY=
ATLAS_CONTACT_EMAIL=

# Atlas backend (atlasd) connection — server-side only, see docs/atlas-integration.md
# Leave ATLAS_ENABLED off (or ATLAS_API_URL empty) to keep the dock in preview mode.
ATLAS_ENABLED=false
ATLAS_API_URL=http://127.0.0.1:8000
ATLAS_REQUEST_TIMEOUT_MS=30000

# LinkedIn OAuth / Share on LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:4321/api/oauth/linkedin/callback

# TikTok OAuth / Display API / Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:4321/api/oauth/tiktok/callback

# X API pay-per-use
X_API_KEY=
X_API_SECRET=
X_BEARER_TOKEN=
X_MONTHLY_BUDGET_USD=25
