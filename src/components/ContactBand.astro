---
import { ArrowUpRight, Github, Linkedin, Mail } from "lucide-astro";
import { profile } from "../data/profile";
---

<section class="contact" id="contact" aria-labelledby="contact-title" data-parallax-scope>
  <div class="contact__wash" aria-hidden="true" data-parallax="0.16"></div>

  <div class="container--wide contact__inner">
    <p class="eyebrow">Contact</p>

    <h2 class="display display--sm text-gradient contact__title" id="contact-title">
      Let&rsquo;s build<br />something useful
    </h2>

    <p class="contact__lead" data-split>
      Open to work on applied AI, agent systems, automation and engineering software.
    </p>

    <div class="contact__actions">
      <a class="button button--primary" href={profile.links.email} data-magnetic="0.3">
        <Mail size={16} strokeWidth={1.9} />
        <span>Email</span>
      </a>
      <a
        class="button"
        href={profile.links.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        data-magnetic="0.3"
      >
        <Linkedin size={16} strokeWidth={1.9} />
        <span>LinkedIn</span>
      </a>
      <a
        class="button"
        href={profile.links.github}
        target="_blank"
        rel="noopener noreferrer"
        data-magnetic="0.3"
      >
        <Github size={16} strokeWidth={1.9} />
        <span>GitHub</span>
      </a>
      <a
        class="button button--icon"
        href={profile.links.lattes}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Lattes academic CV"
      >
        <ArrowUpRight size={16} strokeWidth={1.9} />
      </a>
    </div>
  </div>
</section>

<style>
  .contact {
    position: relative;
    padding-block: calc(var(--section-y) * 1.2);
    overflow: hidden;
    border-top: 1px solid var(--line);
    isolation: isolate;
  }

  .contact__wash {
    position: absolute;
    bottom: -50%;
    left: 50%;
    z-index: -1;
    width: min(150vw, 1800px);
    aspect-ratio: 2 / 1;
    background: radial-gradient(
      ellipse at center,
      rgba(74, 158, 224, 0.22) 0%,
      transparent 62%
    );
    transform: translateX(-50%);
    pointer-events: none;
  }

  .contact__inner {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }

  .contact__lead {
    max-width: 44ch;
    font-size: var(--step-1);
    color: var(--text-soft);
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }
</style>
