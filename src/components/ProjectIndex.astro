---
import { ArrowUpRight } from "lucide-astro";
import { otherProjects } from "../data/projects";
---

<ul class="work-index">
  {otherProjects.map((project, index) => {
    const Tag = project.href ? "a" : "div";
    const linkProps = project.href
      ? { href: project.href, target: "_blank", rel: "noopener noreferrer" }
      : {};

    return (
      <li class="work-index__row" data-reveal>
        <Tag class="work-index__link" {...linkProps}>
          <span class="meta work-index__num">{String(index + 2).padStart(2, "0")}</span>

          <span class="work-index__main">
            <span class="work-index__name">{project.name}</span>
            <span class="work-index__body">{project.body}</span>
          </span>

          <span class="work-index__tags">
            {project.tags.slice(0, 3).map((tag) => <span class="tag">{tag}</span>)}
          </span>

          <span class="meta work-index__year">{project.year}</span>

          <span class="work-index__icon" aria-hidden="true">
            {project.href ? <ArrowUpRight size={18} strokeWidth={1.7} /> : null}
          </span>
        </Tag>
      </li>
    );
  })}
</ul>

<style>
  .work-index {
    border-top: 1px solid var(--line);
  }

  .work-index__row {
    border-bottom: 1px solid var(--line);
  }

  .work-index__link {
    position: relative;
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) auto 7rem 2rem;
    gap: var(--space-5);
    align-items: center;
    padding-block: var(--space-5);
    transition: color var(--dur-2) var(--ease-out);
  }

  /* A wash that wipes in from the left on hover. Cheap, GPU-only, and it is
     what makes a plain list feel like an interface rather than a table. */
  .work-index__link::before {
    position: absolute;
    inset: 0 calc(var(--space-4) * -1);
    z-index: -1;
    content: "";
    background: linear-gradient(90deg, var(--accent-dim), transparent 70%);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform var(--dur-3) var(--ease-out);
  }

  a.work-index__link:hover::before {
    transform: scaleX(1);
  }

  .work-index__num {
    color: var(--text-mute);
  }

  a.work-index__link:hover .work-index__num {
    color: var(--accent);
  }

  .work-index__main {
    display: grid;
    gap: var(--space-2);
    min-width: 0;
  }

  .work-index__name {
    font-size: var(--step-2);
    line-height: 1.14;
    letter-spacing: -0.015em;
  }

  .work-index__body {
    max-width: 60ch;
    font-size: var(--step--1);
    color: var(--text-soft);
  }

  .work-index__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    justify-content: flex-end;
    max-width: 22rem;
  }

  .work-index__year {
    text-align: right;
    white-space: nowrap;
  }

  .work-index__icon {
    display: grid;
    place-items: center;
    color: var(--text-mute);
    transition:
      transform var(--dur-2) var(--ease-out),
      color var(--dur-2) var(--ease-out);
  }

  a.work-index__link:hover .work-index__icon {
    color: var(--accent);
    transform: translate(3px, -3px);
  }

  @media (max-width: 1100px) {
    .work-index__link {
      grid-template-columns: 3rem minmax(0, 1fr) 6rem 1.5rem;
    }

    .work-index__tags {
      display: none;
    }
  }

  @media (max-width: 620px) {
    .work-index__link {
      grid-template-columns: 2.5rem minmax(0, 1fr) 1.5rem;
      align-items: start;
    }

    .work-index__year {
      display: none;
    }
  }
</style>
