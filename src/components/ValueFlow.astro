---
import { Bot, CheckCircle2, GitBranch, SearchCode } from "lucide-astro";

const steps = [
  {
    title: "Map the real workflow",
    icon: SearchCode,
    body: "Start from the actual files, teams, data sources, and decisions that create friction."
  },
  {
    title: "Build the reasoning layer",
    icon: GitBranch,
    body: "Connect retrieval, structured data, model calls, and domain rules into a maintainable system."
  },
  {
    title: "Automate with control",
    icon: Bot,
    body: "Expose tools only where the assistant has clear permissions, context, and fallback behavior."
  },
  {
    title: "Ship decision support",
    icon: CheckCircle2,
    body: "Deliver interfaces that help people compare, act, and iterate with traceable evidence."
  }
];
---

<div class="value-flow">
  {
    steps.map((step, index) => {
      const Icon = step.icon;

      return (
        <article class="value-flow__step" data-reveal data-reveal-delay={index * 70}>
          <span class="value-flow__number">{String(index + 1).padStart(2, "0")}</span>
          <Icon size={28} strokeWidth={1.7} aria-hidden="true" />
          <h3>{step.title}</h3>
          <p>{step.body}</p>
        </article>
      );
    })
  }
</div>
