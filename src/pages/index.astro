---
import ApiStrategy from "../components/ApiStrategy.astro";
import ArchitectureStrip from "../components/ArchitectureStrip.astro";
import ContactBand from "../components/ContactBand.astro";
import ExperienceTimeline from "../components/ExperienceTimeline.astro";
import ExpertiseGrid from "../components/ExpertiseGrid.astro";
import Hero from "../components/Hero.astro";
import Layout from "../components/Layout.astro";
import ProjectShowcase from "../components/ProjectShowcase.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { profile } from "../data/profile";
---

<Layout>
  <Hero />

  <main>
    <section class="section section--paper" id="expertise">
      <div class="container">
        <SectionHeading
          eyebrow="Positioning"
          title="Applied AI engineer with scientific depth and product instincts."
          body={profile.summary}
        />
        <div class="metric-row" aria-label="Profile metrics">
          {profile.metrics.map((metric) => (
            <div class="metric">
              <strong>{metric.value}</strong>
              <span>{metric.label}</span>
            </div>
          ))}
        </div>
        <ExpertiseGrid />
      </div>
    </section>

    <section class="section" id="experience">
      <div class="container">
        <SectionHeading
          eyebrow="Experience"
          title="A career arc from environmental intelligence to agentic business systems."
          body="The common thread is turning technical systems into usable intelligence: research data, engineering simulations, corporate workflows, and AI assistants."
        />
        <ExperienceTimeline />
      </div>
    </section>

    <section class="section section--warm" id="projects">
      <div class="container">
        <SectionHeading
          eyebrow="Selected Work"
          title="Projects that show the direction of the portfolio."
          body="The GitHub profile is strongest when it is framed as an applied AI laboratory: agents, retrieval systems, CLI tools, and domain-specific assistants."
        />
        <ProjectShowcase />
      </div>
    </section>

    <section class="section" id="architecture">
      <div class="container">
        <SectionHeading
          eyebrow="Architecture"
          title="Prepared for official APIs and richer agent interaction."
          body="The current build is not a static resume dressed as an app. It separates content, UI, API capability registry, and the Atlas interaction layer so each part can evolve independently."
        />
        <ArchitectureStrip />
      </div>
    </section>

    <section class="section section--paper" id="apis">
      <div class="container">
        <SectionHeading
          eyebrow="Official APIs"
          title="A practical integration roadmap for LinkedIn, TikTok, and X."
          body="The API plan uses official platform capabilities only. LinkedIn is the best first step, TikTok can support media proof, and X should stay behind explicit spend limits."
        />
        <ApiStrategy />
      </div>
    </section>
  </main>

  <ContactBand />
</Layout>
