---
import ApiStrategy from "../components/ApiStrategy.astro";
import ArchitectureStrip from "../components/ArchitectureStrip.astro";
import CapabilityMap from "../components/CapabilityMap.astro";
import ContactBand from "../components/ContactBand.astro";
import ExperienceTimeline from "../components/ExperienceTimeline.astro";
import Hero from "../components/Hero.astro";
import Layout from "../components/Layout.astro";
import ProjectShowcase from "../components/ProjectShowcase.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ValueFlow from "../components/ValueFlow.astro";
import { profile } from "../data/profile";
---

<Layout>
  <Hero />

  <main id="main">
    <section class="section section--paper section--capabilities" id="expertise">
      <div class="container">
        <SectionHeading
          eyebrow="Capabilities and offers"
          title="Applied AI, automation, and scientific computing in one operating range."
          body="A portfolio layout should make the technical range legible fast: what can be built, where the evidence comes from, and how the work maps to real systems."
        />
        <div class="metric-row" aria-label="Profile metrics" data-reveal>
          {profile.metrics.map((metric) => (
            <div class="metric">
              <strong>{metric.value}</strong>
              <span>{metric.label}</span>
            </div>
          ))}
        </div>
        <CapabilityMap />
      </div>
    </section>

    <section class="section section--value" id="value">
      <div class="container">
        <SectionHeading
          eyebrow="Value proposition"
          title="From raw context to useful engineering decisions."
          body="The work is strongest when it connects model reasoning to a concrete operating surface: retrieval, automation, dashboards, internal tools, and domain-specific assistants."
        />
        <ValueFlow />
      </div>
    </section>

    <section class="section section--story" id="experience">
      <div class="container">
        <SectionHeading
          eyebrow="Experience"
          title="A career arc from environmental intelligence to agentic business systems."
          body="The common thread is turning technical systems into usable intelligence: research data, engineering simulations, corporate workflows, and AI assistants."
        />
        <ExperienceTimeline />
      </div>
    </section>

    <section class="section section--warm section--projects" id="projects">
      <div class="container">
        <SectionHeading
          eyebrow="Selected Work"
          title="Projects that show the direction of the portfolio."
          body="The GitHub profile is strongest when it is framed as an applied AI laboratory: agents, retrieval systems, CLI tools, and domain-specific assistants."
        />
        <ProjectShowcase />
      </div>
    </section>

    <section class="section section--workflow" id="architecture">
      <div class="container">
        <SectionHeading
          eyebrow="Methods and workflows"
          title="A portfolio architecture ready for richer agent interaction."
          body="Like the reference layout, this section turns architecture into a visible system: content, interface, official API layer, and evidence registry."
        />
        <ArchitectureStrip />
      </div>
    </section>

    <section class="section section--paper" id="apis">
      <div class="container">
        <SectionHeading
          eyebrow="Official APIs"
          title="A practical integration roadmap for LinkedIn, TikTok, and X."
          body="The API plan uses official platform capabilities only. LinkedIn is the best first step, TikTok can support media proof, and X should stay behind explicit spend limits."
        />
        <ApiStrategy />
      </div>
    </section>
  </main>

  <ContactBand />
</Layout>
