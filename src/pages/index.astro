---
import CapabilityMap from "../components/CapabilityMap.astro";
import ContactBand from "../components/ContactBand.astro";
import ExperienceTimeline from "../components/ExperienceTimeline.astro";
import FeaturedProject from "../components/FeaturedProject.astro";
import Hero from "../components/Hero.astro";
import Layout from "../components/Layout.astro";
import ProjectIndex from "../components/ProjectIndex.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { profile } from "../data/profile";

const dots = [
  { id: "top", label: "Top" },
  { id: "work", label: "Work" },
  { id: "capabilities", label: "Capabilities" },
  { id: "experience", label: "Experience" },
  { id: "contact", label: "Contact" }
];
---

<Layout dots={dots}>
  <Hero />

  <main id="main">
    <FeaturedProject />

    <section class="section" aria-labelledby="archive-title">
      <div class="container--wide">
        <div class="section-heading">
          <p class="eyebrow">Also built</p>
          <h2 id="archive-title" data-split>
            Agents, retrieval systems and the tooling that makes them usable.
          </h2>
        </div>
        <ProjectIndex />
      </div>
    </section>

    <section class="section section--surface" id="capabilities" aria-labelledby="capabilities-title">
      <div class="container--wide">
        <SectionHeading
          eyebrow="Capabilities"
          title="Applied AI, automation and scientific computing in one operating range."
          body="The through-line is turning model reasoning into a concrete operating surface: retrieval, automation, internal tools and domain-specific assistants."
          titleId="capabilities-title"
        />

        <dl class="metrics" data-reveal-group>
          {profile.metrics.map((metric) => (
            <div class="metric">
              <dd data-count={Number(metric.value.replace(/\D/g, "")) || undefined}>
                {metric.value}
              </dd>
              <dt class="meta">{metric.label}</dt>
            </div>
          ))}
        </dl>

        <CapabilityMap />
      </div>
    </section>

    <section class="section" id="experience" aria-labelledby="experience-title">
      <div class="container--wide">
        <SectionHeading
          eyebrow="Experience"
          title="From environmental intelligence to agentic business systems."
          body="The common thread is turning technical systems into usable intelligence: research data, engineering simulations, corporate workflows and AI assistants."
          titleId="experience-title"
        />
        <ExperienceTimeline />
      </div>
    </section>
  </main>

  <ContactBand />
</Layout>

<style>
  .metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
    margin: 0 0 var(--space-8);
    padding-block: var(--space-6);
    border-block: 1px solid var(--line);
  }

  .metric {
    display: grid;
    gap: var(--space-2);
  }

  .metric dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-5);
    line-height: 1;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 720px) {
    .metrics {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }
</style>
